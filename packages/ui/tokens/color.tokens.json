    },
    "fg-subtle": {
      "$value": "{palette.neutral.text-subtle}",
      "$description": "Tertiary text: meta, placeholders (still 4.5:1)."
    },
    "fg-disabled": {
      "$value": "{palette.neutral.8}",
      "$description": "Disabled text; exempt from contrast requirements."
    },
    "icon-subtle": {
      "$value": "{palette.neutral.border-input}",
      "$description": "Icons that stay out of the way until wanted, such as a quiet link (3:1, WCAG 1.4.11). Never text."
    },
    "border": {
      "$value": "{palette.neutral.6}",
      "$description": "Separators and container edges."
    },
    "border-strong": {
      "$value": "{palette.neutral.7}",
