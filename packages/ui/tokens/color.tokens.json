{
  "$description": "Semantic colours. $value is light mode; com.openlinkos.dark is dark mode.",
  "color": {
    "$type": "color",
    "shell": {
      "$value": "{palette.neutral.3}",
      "$description": "The app shell around the floating content panel, and the sidebar.",
      "$extensions": {
        "com.openlinkos": {
          "dark": "{palette.neutral.1}"
        }
      }
    },
    "bg": {
      "$value": "{palette.neutral.1}",
      "$description": "The app background."
    },
    "bg-subtle": {
      "$value": "{palette.neutral.2}",
      "$description": "Recessed areas: sidebar, table headings, code."
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      },
      "$description": "Content surfaces: the floating panel, tables, inputs.",
      "$extensions": {
        "com.openlinkos": {
          "dark": "{palette.neutral.2}"
        }
      }
    },
    "surface-overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      },
      "$description": "Floating surfaces: menus, popovers, dialogs, toasts.",
      "$extensions": {
        "com.openlinkos": {
          "dark": "{palette.neutral.3}"
        }
      }
    },
    "fill-subtle": {
      "$value": "{palette.neutral.2}",
