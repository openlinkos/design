{
  "name": "@openlinkos/vitepress-theme",
  "version": "0.8.0-rc.3",
  "description": "The shared VitePress theme of OpenLinkOS and LinkOS sites: brand, bilingual interface, language detection, metadata, a bilingual coverage check, a layer for agents (llms.txt and every page as Markdown) and the landing-page components.",
  "license": "MIT",
  "author": "OpenLinkOS",
  "homepage": "https://github.com/openlinkos/design/tree/master/packages/vitepress-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlinkos/design.git",
    "directory": "packages/vitepress-theme"
  },
  "bugs": {
    "url": "https://github.com/openlinkos/design/issues"
  },
  "keywords": [
    "vitepress",
    "vitepress-theme",
    "openlinkos"
  ],
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "@openlinkos/ui": "workspace:*"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vue": "3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
